# GoGeM — variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA commitar o .env real (ver .gitignore / CLAUDE.md §8).

# ── API núcleo (apps/api) ──────────────────────────────────────────
DATABASE_URL=postgresql://gogem:gogem@localhost:5432/gogem
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-segredo-forte-min-32-chars
PORT=3000

# ── MinIO (mídia / OTA) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gogem-media

# ── Integração Regem ───────────────────────────────────────────────
# Token de dispositivo (X-Sync-Token) emitido pelo Regem para este tenant.
REGEM_API_BASE=https://api.dmsregem.com/api/v1
REGEM_SYNC_TOKEN=
