# GoGeM — variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA commitar o .env real (ver .gitignore / CLAUDE.md §8).

# ── API núcleo (apps/api) ──────────────────────────────────────────
DATABASE_URL=postgresql://gogem:gogem@localhost:5432/gogem
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-segredo-forte-min-32-chars
# Chave dos segredos das integrações (token do Regem, access token do Mercado Pago):
# 32 bytes em base64. Sem ela a API sobe, mas recusa guardar credencial nova.
# Gere uma por ambiente e NUNCA reaproveite a de produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOGEM_CHAVE_DOS_SEGREDOS=
PORT=3000

# ── MinIO (mídia / OTA) ────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gogem-media

# ── Integração Regem ───────────────────────────────────────────────
# Não há "Regem padrão" por env (ERR-012): cada empresa configura a SUA
# integração (apiBase + token) no painel, em Integrações → Regem.
