# ======== GoGeM API — staging (.env) ========
# Banco (serviço gogem-db no mesmo projeto EasyPanel)
DATABASE_URL=postgresql://gogem:TROQUE_A_SENHA@gogem-db:5432/gogem?schema=public
REDIS_URL=redis://gogem-redis:6379

# Segurança — gere com: openssl rand -hex 48
JWT_SECRET=TROQUE_64_CHARS_ALEATORIOS

PORT=3000
NODE_ENV=production

# CORS — origens do painel (admin) que podem chamar a API. Lista separada por
# vírgula. SEM esta var o CORS reflete qualquer origem (só para dev).
CORS_ORIGIN=https://admin-stg.gogem.com.br

# Integração Regem
REGEM_API_BASE=https://api.dmsregem.com/api/v1
# token do equipamento tipo servidor_local cadastrado no tenant do cliente no Regem:
REGEM_SYNC_TOKEN=TROQUE_TOKEN_DO_EQUIPAMENTO

# MinIO (serviço gogem-media)
S3_ENDPOINT=http://gogem-media:9000
S3_ACCESS_KEY=TROQUE
S3_SECRET_KEY=TROQUE
S3_BUCKET=gogem
