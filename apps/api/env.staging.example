# ======== GoGeM API — staging (.env) ========
# Banco (serviço gogem-db no mesmo projeto EasyPanel)
DATABASE_URL=postgresql://gogem:TROQUE_A_SENHA@gogem-db:5432/gogem?schema=public
REDIS_URL=redis://gogem-redis:6379

# Segurança — gere com: openssl rand -hex 48
JWT_SECRET=TROQUE_64_CHARS_ALEATORIOS

# Chave dos segredos das integrações (32 bytes em base64). Gere com:
#   openssl rand -base64 32
# Sem ela a API recusa guardar credencial nova. Trocar a chave sem recifrar
# tranca as credenciais já guardadas (a venda passa a responder 503).
GOGEM_CHAVE_DOS_SEGREDOS=TROQUE_32_BYTES_EM_BASE64

# Endereço público desta API, para o registro dos avisos assinados do Regem
# (`{este}/sync/regem/avisos/<id>`). Padrão: https://api.gogem.com.br/api/v1.
# O Regem só aceita o de produção, a não ser que a distribuição dele libere outro
# (INTEGRACAO_GOGEM_WEBHOOK_URLS, no Regem). Opcional.
# GOGEM_URL_PUBLICA_API=https://api-stg.gogem.com.br/api/v1

PORT=3000
NODE_ENV=production

# Swagger (/api/v1/docs): FECHADO em produção por padrão. Ligue só se precisar
# inspecionar o contrato num ambiente controlado.
# SWAGGER_ENABLED=true

# CORS — origens do painel (admin) que podem chamar a API. Lista separada por
# vírgula. SEM esta var o CORS reflete qualquer origem (só para dev).
CORS_ORIGIN=https://admin-stg.gogem.com.br

# Integração Regem: NÃO vai em env (ERR-012). Cada empresa configura a sua
# (apiBase + token) no painel, em Integrações → Regem.

# MinIO (serviço gogem-media)
S3_ENDPOINT=http://gogem-media:9000
S3_ACCESS_KEY=TROQUE
S3_SECRET_KEY=TROQUE
S3_BUCKET=gogem

# "Conectar pelo Regem" (Hub DMS F6): o presidente da empresa autoriza no próprio
# Regem, loja por loja, e ninguém cola token. Desligado sem GOGEM_REGEM_CLIQUE=true
# (o cartão segue só com o token colado). Configuração torta não liga: o motivo vai ao log.
# GOGEM_REGEM_CLIQUE=true
# Endereços, só https (os padrões são os de produção):
# GOGEM_REGEM_API_URL=https://api.dmsregem.com/api/v1
# GOGEM_REGEM_APP_URL=https://app.dmsregem.com
# GOGEM_PAINEL_URL=https://app.gogem.com.br
# O aplicativo M2M do GoGeM no DMS ID (a distribuição cria e configura; o segredo
# NUNCA vai para o git). O emissor é o endereço https do DMS ID com /oidc.
# DMS_ID_EMISSOR=https://id.dmstecnologias.com/oidc
# DMS_ID_APLICATIVO=
# DMS_ID_SEGREDO=
