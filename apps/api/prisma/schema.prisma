// GoGeM — schema Prisma (PostgreSQL).
//
// Convenções inegociáveis (CLAUDE.md):
//   §2 Multi-tenant: TODA tabela de negócio carrega `tenantId` + índice; o
//      escopo por tenant é aplicado no middleware do PrismaService (stub).
//   §3 Catálogo versionado: publicar gera uma linha em MenuVersion; o totem
//      sincroniza por versão (delta).
//   §4 De-para PDV: Produto carrega `externalRefs` (Json) =
//      [{ sistema, codigo_pdv, loja }]. A integração com o Regem SEMPRE
//      referencia `codigo_pdv`, nunca o id interno.
//
// S1: skeleton mínimo e coerente — NÃO é o CRUD completo (entra no S1–S2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RBAC do GoGeM/Regem (CLAUDE.md — hierarquia de perfis).
enum Papel {
  presidente
  gerente
  supervisao
  execucao
}

// Empresa (raiz do multi-tenant). É o próprio tenant.
model Tenant {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidades           Unidade[]
  usuarios           Usuario[]
  categorias         Categoria[]
  produtos           Produto[]
  menuVersions       MenuVersion[]
  complementoGrupos  ComplementoGrupo[]
  complementoOpcoes  ComplementoOpcao[]
  produtoComplementos ProdutoComplemento[]
  produtoUpsells     ProdutoUpsell[]
  openDeliveryApps   OpenDeliveryApp[]
  openDeliveryOrders OpenDeliveryOrder[]
  openDeliveryEvents OpenDeliveryEvent[]
  dispositivos       Dispositivo[]
  pedidos            Pedido[]
  integracoes        Integracao[]
  cardapios          Cardapio[]
  aparencia          Aparencia?
  pixCharges         PixCharge[]
  pointPayments      PointPayment[]

  @@map("tenants")
}

// Cobrança PIX via PSP (F8). O totem cria (POST /pagamentos/pix), mostra o QR e
// faz polling (GET /pagamentos/pix/:id); o PSP confirma por webhook. Credenciais
// do PSP ficam no backend — o app nunca as vê. `psp` = adaptador usado
// (sandbox|mercadopago); `pspRef` = id do pagamento no PSP.
model PixCharge {
  id          String    @id @default(uuid())
  tenantId    String
  orderId     String // UUID do pedido = idempotência
  amountCents Int
  status      String    @default("pending") // pending|approved|expired|cancelled|error
  psp         String
  pspRef      String?
  copiaECola  String?
  qrImage     String? // data URI (base64) do QR
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId])
  @@index([tenantId])
  @@index([pspRef])
  @@map("pix_charges")
}

// Cobrança de CARTÃO na maquininha Point Smart do Mercado Pago (modo PDV). O
// totem cria uma payment intent (POST /pagamentos/point) para o `deviceId` da
// loja → a maquininha acende → cliente passa o cartão → volta por webhook +
// polling (GET /pagamentos/point/:id). Reusa o access token do MP (integração
// mercadopago). `intentId` = id da payment intent; `paymentId` = pagamento final.
model PointPayment {
  id          String   @id @default(uuid())
  tenantId    String
  orderId     String // UUID do pedido = idempotência
  deviceId    String
  intentId    String?
  amountCents Int
  tipo        String   @default("credit") // credit|debito|credito|voucher (real após aprovar)
  bandeira    String? // payment_method_id do MP (visa|master|elo|alelo|sodexo|vr|…)
  status      String   @default("pending") // pending|approved|cancelled|error
  paymentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId])
  @@index([tenantId])
  @@index([intentId])
  @@map("point_payments")
}

// Release do APK do totem (auto-update). GLOBAL — NÃO é por tenant: o app é o
// mesmo produto para todas as lojas. O DMS publica (token de release); o totem
// consulta /kiosk/latest, compara o versionCode, baixa o apkUrl e confere o
// sha256. `ativo` permite despublicar; `obrigatorio` = update forçado.
model KioskRelease {
  id          String   @id @default(uuid())
  versionCode Int      @unique
  versionName String
  apkUrl      String
  sha256      String
  notas       String?
  obrigatorio Boolean  @default(false)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("kiosk_releases")
}

// Aparência do totem POR LOJA (Fase 6). O admin configura e o totem aplica no
// próximo sync (vai no `/catalogo/publicado`). O render é do app do totem; aqui
// só guardamos os tokens. Cores em hex; `descansoMidias` = [{ url, tipo }].
model Aparencia {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  corPrimaria          String   @default("#FFC24B")
  corDestaque          String   @default("#3ECF8E")
  corFundo             String   @default("#0F1713")
  corPainel            String   @default("#16211B")
  raio                 Int      @default(16)
  nomeLoja             String?
  logoUrl              String?
  fonteDisplay         String   @default("Tektur")
  // Preset visual do totem (F3): 'padrao' | 'brasa' (steakhouse dark). Muda o
  // estilo do descanso/cards sem trocar as cores da loja.
  temaPreset           String   @default("padrao")
  descansoTipo         String   @default("padrao") // 'padrao' | 'carrossel'
  descansoIntervaloSeg Int      @default(6)
  descansoMidias       Json     @default("[]")
  chamada              String   @default("TOQUE PARA PEDIR")
  precoIsca            String?
  estiloCard           String   @default("cheia") // 'cheia' | 'lateral'
  animacoes            String   @default("cheio") // 'cheio' | 'reduzido' | 'off'
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("aparencias")
}

// App parceiro do modo Open Delivery (GoGeM como PROVEDOR): terceiros integram-se
// à loja pela API pública `/open-delivery/v1`. Cada app tem clientId público +
// clientSecret hasheado (nunca em claro) e escopos. Tenant-scoped (gestão pelo
// admin); o endpoint /oauth/token busca por clientId cross-tenant (runAsSystem)
// e emite um JWT curto com o tenant do app.
model OpenDeliveryApp {
  id               String    @id @default(uuid())
  tenantId         String
  nome             String
  clientId         String    @unique
  clientSecretHash String
  // Escopos concedidos: 'catalog:read' | 'orders:write' | 'orders:read'.
  escopos          String[]  @default([])
  ativo            Boolean   @default(true)
  ultimoUso        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("open_delivery_apps")
}

// Pedido recebido via Open Delivery (inbound de um parceiro). Idempotente por
// (tenant, displayId). Guarda o payload OD (reais) + total em centavos. A
// materialização em comanda/produção do ERP é follow-up; aqui é o registro + a
// máquina de status que o parceiro acompanha pelos eventos.
model OpenDeliveryOrder {
  id            String   @id @default(uuid())
  tenantId      String
  appId         String?
  // ID do pedido no parceiro (idempotência).
  displayId     String
  // PLACED|CONFIRMED|PREPARING|READY|DISPATCHED|CONCLUDED|CANCELLED
  status        String   @default("PLACED")
  customerNome  String?
  customerDoc   String?
  itens         Json
  pagamentos    Json
  totalCentavos Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@map("open_delivery_orders")
}

// Fila de eventos do Open Delivery (o parceiro consome por long-polling e dá
// acknowledgment). Não-acked = pendente. Tenant-scoped.
model OpenDeliveryEvent {
  id             String    @id @default(uuid())
  tenantId       String
  // ORDER_PLACED | ORDER_STATUS_CHANGED | ORDER_CANCELLED
  tipo           String
  orderId        String
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, acknowledgedAt])
  @@map("open_delivery_events")
}

// Cardápio (Fase 3B): um conjunto INDEPENDENTE de categorias+produtos. Um tenant
// pode ter até 2 (regra no service); exatamente 1 fica `ativo`. O totem recebe
// SEMPRE o cardápio ativo (a publicação snapshota o ativo). O inativo serve para
// preparar uma migração de sistema / testes antes de ativar (criado vazio,
// duplicando o ativo, ou importando de um sistema integrado).
model Cardapio {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  ativo     Boolean  @default(false)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  categorias Categoria[]
  produtos   Produto[]

  @@index([tenantId])
  @@map("cardapios")
}

// Loja (unidade operacional de um tenant).
model Unidade {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  usuarios Usuario[]

  @@index([tenantId])
  @@map("unidades")
}

model Usuario {
  id        String   @id @default(uuid())
  tenantId  String
  unidadeId String?
  nome      String
  email     String
  senhaHash String
  papel     Papel    @default(execucao)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  unidade Unidade? @relation(fields: [unidadeId], references: [id])

  // e-mail único por tenant (não global).
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("usuarios")
}

model Categoria {
  id         String   @id @default(uuid())
  tenantId   String
  // Cardápio ao qual a categoria pertence (Fase 3B). Nulo só em dados legados
  // pré-migração; o service sempre resolve o cardápio ativo.
  cardapioId String?
  nome       String
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  cardapio Cardapio? @relation(fields: [cardapioId], references: [id])
  produtos Produto[]

  @@index([tenantId])
  @@index([cardapioId])
  @@map("categorias")
}

model Produto {
  id           String   @id @default(uuid())
  tenantId     String
  // Cardápio ao qual o produto pertence (Fase 3B). Nulo só em legado.
  cardapioId   String?
  categoriaId  String?
  nome         String
  descricao    String?
  precoCentavos Int     @default(0)
  disponivel   Boolean  @default(true)
  // Selo de destaque no card do totem (F4): ex. "Mais vendido", "Novidade".
  // Texto livre curto; nulo = sem selo.
  selo         String?
  // URL pública da foto do produto (Supabase Storage). Nulo = sem foto.
  imagemUrl    String?
  // De-para PDV (§4): array de { sistema, codigo_pdv, loja }.
  externalRefs Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  cardapio    Cardapio?  @relation(fields: [cardapioId], references: [id])
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  complementos ProdutoComplemento[]
  // Upsell "Peça também" (F2): sugestões configuradas neste produto (dono) e
  // ocorrências deste produto como sugerido de outros.
  upsells      ProdutoUpsell[] @relation("UpsellDono")
  sugeridoEm   ProdutoUpsell[] @relation("UpsellSugerido")

  @@index([tenantId])
  @@index([cardapioId])
  @@index([categoriaId])
  @@map("produtos")
}

// Upsell / "Peça também" (F2): sugestão configurada POR produto (o lojista
// indica, no admin, quais produtos cadastrados sugerir). No checkout o totem
// agrega as sugestões dos itens do carrinho, deduplica e exclui o que já está no
// carrinho. Auto-referência N:N em Produto. Tenant-scoped (§2); `ordem` define a
// prioridade de exibição.
model ProdutoUpsell {
  id         String @id @default(uuid())
  tenantId   String
  // Produto "gatilho" (quando ele está no carrinho, sugerimos o `sugerido`).
  produtoId  String
  // Produto sugerido.
  sugeridoId String
  ordem      Int    @default(0)

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  produto  Produto @relation("UpsellDono", fields: [produtoId], references: [id], onDelete: Cascade)
  sugerido Produto @relation("UpsellSugerido", fields: [sugeridoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, sugeridoId])
  @@index([tenantId])
  @@index([produtoId])
  @@map("produto_upsells")
}

// Etapa/complemento REUTILIZÁVEL — ex.: "Escolha a bebida". Deixa de ser presa a
// um produto (Fase etapas reutilizáveis): a mesma etapa pode ser vinculada a
// vários produtos via `ProdutoComplemento`. min/max regem a seleção; max nulo =
// ilimitado. Tenant-scoped (§2). A ORDEM da etapa é por produto (no vínculo).
model ComplementoGrupo {
  id          String   @id @default(uuid())
  tenantId    String
  nome        String
  min         Int      @default(0)
  max         Int?
  obrigatorio Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  opcoes   ComplementoOpcao[]
  produtos ProdutoComplemento[]

  @@index([tenantId])
  @@map("complemento_grupos")
}

// Vínculo N:N produto ↔ etapa (reutilizável). `ordem` = posição da etapa NESTE
// produto. Uma etapa aparece no máximo uma vez por produto.
model ProdutoComplemento {
  id        String   @id @default(uuid())
  tenantId  String
  produtoId String
  grupoId   String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  produto Produto          @relation(fields: [produtoId], references: [id])
  grupo   ComplementoGrupo @relation(fields: [grupoId], references: [id])

  @@unique([produtoId, grupoId])
  @@index([tenantId])
  @@index([produtoId])
  @@index([grupoId])
  @@map("produto_complementos")
}

// Opção de um grupo de complementos. `precoCentavosDelta` é um delta (inteiro,
// nunca float) sobre o preço-base do produto. Carrega de-para PDV (§4) no
// mesmo shape do Produto: [{ sistema, codigo_pdv, loja? }]. Tenant-scoped.
model ComplementoOpcao {
  id                 String   @id @default(uuid())
  tenantId           String
  grupoId            String
  nome               String
  precoCentavosDelta Int      @default(0)
  disponivel         Boolean  @default(true)
  // Foto da opção (Supabase Storage). Nulo = sem foto.
  imagemUrl          String?
  ordem              Int      @default(0)
  // De-para PDV (§4): array de { sistema, codigo_pdv, loja }.
  externalRefs       Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  grupo  ComplementoGrupo @relation(fields: [grupoId], references: [id])

  @@index([tenantId])
  @@index([grupoId])
  @@map("complemento_opcoes")
}

// Publicação versionada do catálogo (§3). Ao publicar, o rascunho é
// congelado num `snapshot` (árvore completa do cardápio) imutável; o totem
// sincroniza por `versao` (delta). `publishedById` = usuário que publicou.
model MenuVersion {
  id            String   @id @default(uuid())
  tenantId      String
  versao        Int
  // Árvore completa do catálogo publicado (categorias + produtos + grupos +
  // opções). Imutável — snapshot do rascunho no momento da publicação.
  snapshot      Json
  publishedById String?
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, versao])
  @@index([tenantId])
  @@map("menu_versions")
}

// Dispositivo (totem) pareado a um tenant (issue #12.1). O totem se autentica
// por um `token` de dispositivo (revogável) — espelha o padrão do equipamento
// do Regem: o token é gravado direto na linha e conferido a cada requisição.
//
// Pareamento em 2 tempos (CLAUDE.md §8 — token por dispositivo, pareamento por
// código): o admin cria o Dispositivo e recebe um `codigoPareamento` de 6
// dígitos (uso único, expira em 15 min); o totem troca o código por um `token`
// no endpoint público de pareamento. Tenant-scoped (§2) — o CRUD do admin fica
// isolado pelo middleware; o lookup público roda em `runAsSystem`.
model Dispositivo {
  id               String    @id @default(uuid())
  tenantId         String
  unidadeId        String?
  nome             String
  tipo             String    @default("totem")
  // Token de dispositivo (revogável). Único global; nulo até o pareamento.
  token            String?   @unique
  pareado          Boolean   @default(false)
  codigoPareamento String?
  codigoExpiraEm   DateTime?
  ativo            Boolean   @default(true)
  // Telemetria (heartbeat): último "sinal de vida" + estado reportado (papel,
  // fila, versão do catálogo/app). O online/offline é derivado da recência de
  // `ultimoHeartbeat` no admin.
  ultimoHeartbeat  DateTime?
  ultimoStatus     Json?
  // Maquininha Point vinculada a ESTE totem (modo PDV). Cada totem cobra na sua
  // própria maquininha; nulo = usa o device_id padrão da loja (integração MP).
  pointDeviceId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("dispositivos")
}

// Venda de totem repassada ao Regem (issue #12.2). O totem fala SÓ com o GoGeM:
// ele registra o Pedido aqui e o GoGeM o lança no Regem (`POST /vendas/externa-pdv`,
// auth por `X-Sync-Token`), guardando o token do Regem no servidor — não o
// espalha por totem. Idempotência dupla (CLAUDE.md §1): chave única local
// `(tenantId, idempotencyKey)` + o Regem também dedupe pela mesma `idempotencyKey`.
//
// Dinheiro em centavos inteiros (§ regra do produto): `pagamentos[].valor` é
// centavos; `taxaServicoPct` é um percentual inteiro. Tenant-scoped (§2) — o
// middleware injeta o `tenantId`; o endpoint é device-authed (DeviceTokenGuard).
model Pedido {
  id             String   @id @default(uuid())
  tenantId       String
  dispositivoId  String?
  idempotencyKey String
  cpf            String?
  // Nome informado na hora do pedido (opcional) — para o relatório.
  cliente        String?
  // Tipo de consumo: 'local' (comer aqui) | 'viagem' (para viagem). Segue ao
  // Regem e afeta cozinha/embalagem. Default 'local' (retrocompat).
  consumo        String   @default("local")
  // Itens do pedido: [{ codigoPdv, quantidade, observacao? }] (de-para §4).
  itens          Json
  // Split de pagamento: [{ forma, valor(centavos), nsu?, autorizacao?, formaPagamentoId? }].
  pagamentos     Json
  // Total do pedido em centavos (soma dos pagamentos) — para faturamento.
  totalCentavos  Int      @default(0)
  // Percentual de taxa de serviço (inteiro), ex.: 10 = 10%.
  taxaServicoPct Int?
  // Senha local exibida no totem (repassada ao Regem como senhaPlataforma).
  senhaLocal     Int?
  // pendente | enviado | falha | cancelado — ciclo de vida.
  status         String   @default("pendente")
  // Cancelamento (relatório de cancelados).
  canceladoEm    DateTime?
  canceladoMotivo String?
  // Resultado do Regem (preenchido no sucesso).
  regemComandaId String?
  regemSenha     Int?
  regemResposta  Json?
  // Mensagem de erro do último repasse com falha.
  erro           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Idempotência local: uma venda por chave, por tenant (§1).
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("pedidos")
}

// Integração de um tenant com um sistema externo (Fase 2). O GoGeM é uma API
// aberta de conectores: cada `tipo` (ex.: 'regem', 'open_delivery') tem UMA
// integração por tenant, com credenciais/parâmetros em `config` (Json). Os
// segredos NUNCA voltam crus ao front — o service mascara (só diz se há valor).
//
// O conector Regem lê `config = { apiBase, token }` daqui (resolvido por tenant,
// com fallback para as envs REGEM_API_BASE/REGEM_SYNC_TOKEN do piloto). Assim o
// GoGeM deixa de ser mono-tenant (1 token global) e cada loja pareia a sua.
model Integracao {
  id          String   @id @default(uuid())
  tenantId    String
  // Discriminador do conector: 'regem' | 'open_delivery' | ...
  tipo        String
  // Rótulo amigável opcional (ex.: "Regem — Loja Centro").
  nome        String?
  ativo       Boolean  @default(false)
  // Credenciais/parâmetros do conector. Ex. regem: { apiBase, token }.
  config      Json     @default("{}")
  // Resultado do último teste de conexão: { ok, em, detalhe? }.
  ultimoTeste Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Uma integração por tipo, por tenant.
  @@unique([tenantId, tipo])
  @@index([tenantId])
  @@map("integracoes")
}
