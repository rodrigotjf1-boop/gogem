# apps/api — variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA commitar o .env real (ver .gitignore / CLAUDE.md §8).

# Banco principal multi-tenant (Prisma / PostgreSQL)
DATABASE_URL=postgresql://gogem:gogem@localhost:5432/gogem

# Segredo de assinatura JWT (mín. 32 chars)
JWT_SECRET=troque-por-um-segredo-forte-min-32-chars

# Chave dos segredos das integrações (token do Regem, access token do Mercado Pago):
# 32 bytes em base64. Sem ela a API sobe, mas recusa guardar credencial nova.
# Gere uma por ambiente e NUNCA reaproveite a de produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOGEM_CHAVE_DOS_SEGREDOS=

# Porta HTTP da API
PORT=3000

# ── Integração Regem ───────────────────────────────────────────────
# Não há "Regem padrão" por env (ERR-012): cada empresa configura a SUA
# integração (apiBase + token) no painel, em Integrações → Regem.

# "Conectar pelo Regem" (Hub DMS F6): o presidente da empresa autoriza no próprio
# Regem, loja por loja, e ninguém cola token. Desligado sem GOGEM_REGEM_CLIQUE=true
# (o cartão segue só com o token colado). Configuração torta não liga: o motivo vai ao log.
# GOGEM_REGEM_CLIQUE=true
# Endereços, só https (os padrões são os de produção):
# GOGEM_REGEM_API_URL=https://api.dmsregem.com/api/v1
# GOGEM_REGEM_APP_URL=https://app.dmsregem.com
# GOGEM_PAINEL_URL=https://app.gogem.com.br
# O aplicativo M2M do GoGeM no DMS ID (a distribuição cria e configura; o segredo
# NUNCA vai para o git). O emissor é o endereço https do DMS ID com /oidc.
# DMS_ID_EMISSOR=https://id.dmstecnologias.com/oidc
# DMS_ID_APLICATIVO=
# DMS_ID_SEGREDO=
